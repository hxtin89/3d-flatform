{
  "name": "sbb-pointcloud-viewer",
  "version": "1.0.0",
  "description": "Three.js/WebGPU point cloud viewer — local self-hosted pipeline",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:https": "VITE_HTTPS=1 vite --host",
    "audio:prepare": "node scripts/prepare-sounds.mjs",
    "bench:verify": "node --experimental-strip-types --test src/threejs-test/*.test.ts",
    "build": "node scripts/build-livingdashboard.mjs",
    "preview": "node scripts/preview-livingdashboard.mjs"
  },
  "dependencies": {
    "@sparkjsdev/spark": "^2.1.0",
    "3d-tiles-renderer": "^0.4.28",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@types/three": "^0.185.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "typescript": "^5.4.0",
    "vite": "^7.3.7"
  }
}
