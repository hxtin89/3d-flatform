VITE_AWS_MEDIA_S3_BUCKET_NAME=wilderness-international-media-dev
VITE_AWS_MEDIA_CLOUDFRONT_DISTRIBUTION_DOMAIN=d3ikc68ccylu0h.cloudfront.net
VITE_POINTCLOUD_TILES_FOLDER=pointcloud-tiles

# MapTiler basemap. Two keys, because each one is allow-listed for its own origin
# and answers 403 for every other — see src/maptiler-key.ts. Ask the devs who
# manage the MapTiler account for the values; never commit them.
#   ..._API_KEY        the deployed origins (wi-dev, wilderness-prototype)
#   ..._API_KEY_LOCAL  localhost, any port. Not 127.0.0.1, not a LAN address.
VITE_MAPTILER_API_KEY=
VITE_MAPTILER_API_KEY_LOCAL=
